    {
      "parameters": {
        "jsCode": "\nconst results = $input.first().json.results || {};\n\nconst mapping = {\n  revenue_forecasting: {\n    table: \"revenue\",\n    arrayKey: \"forecasts\",\n  },\n  order_forecasting: {\n    table: \"orders\",\n    arrayKey: \"forecasts\",\n  },\n  product_demand_forecasting: {\n    table: \"product_demand\",\n    arrayKey: \"forecasts\",\n  },\n  customer_churn: {\n    table: \"churn\",\n    arrayKey: \"predictions\",\n  },\n  customer_lifetime_value: {\n    table: \"clv\",\n    arrayKey: \"predictions\",\n  },\n};\n\nconst output = [];\n\nfor (const [model, config] of Object.entries(mapping)) {\n  const response = results[model];\n\n  if (!response || response.status === \"error\") {\n    output.push({\n      json: {\n        Model_Name: model,\n        Destination: config.table,\n        Error: response?.message || \"No response\",\n      },\n    });\n    continue;\n  }\n\n  const rows = response[config.arrayKey] || response.customers || [];\n\n  for (const row of rows) {\n    output.push({\n      json: {\n        Model_Name: model,\n        Destination: config.table,\n        ...row,\n      },\n    });\n  }\n}\n\nreturn output;\n\n\n"
      },
