  <DataSets>
    <DataSet Name="ds_Monthly_Sales">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    Order_Year,
    Order_Month,
    Year_Month_Key,
    Total_Orders,
    Units_Sold,
    Revenue,
    Profit
FROM brainbees_ecommerce.vw_monthly_sales
ORDER BY Year_Month_Key;</CommandText>
      </Query>
      <Fields>
        <Field Name="Order_Year">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Order_Year</DataField>
        </Field>
        <Field Name="Order_Month">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Order_Month</DataField>
        </Field>
        <Field Name="Year_Month_Key">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Year_Month_Key</DataField>
        </Field>
        <Field Name="Total_Orders">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>Total_Orders</DataField>
        </Field>
        <Field Name="Units_Sold">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Units_Sold</DataField>
        </Field>
        <Field Name="Revenue">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Revenue</DataField>
        </Field>
        <Field Name="Profit">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Profit</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Sales_Detail">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    o.Order_ID,
    o.Order_Date,
    o.Customer_ID,
    CONCAT(c.First_Name, ' ', c.Last_Name) AS Customer_Name,
    o.Order_Status,
    o.Order_Channel,
    oi.Product_ID,
    p.Product_Name,
    cat.Category_Name,
    oi.Quantity,
    oi.Unit_Price,
    oi.Discount_Percentage,
    oi.Line_Total,
    oi.Profit_Amount
FROM brainbees_ecommerce.fact_orders o
LEFT JOIN brainbees_ecommerce.fact_order_items oi
    ON o.Order_ID = oi.Order_ID
LEFT JOIN brainbees_ecommerce.dim_customers c
    ON o.Customer_ID = c.Customer_ID
LEFT JOIN brainbees_ecommerce.dim_products p
    ON oi.Product_ID = p.Product_ID
LEFT JOIN brainbees_ecommerce.dim_categories cat
    ON p.Category_ID = cat.Category_ID
ORDER BY
    o.Order_Date,
    o.Order_ID;</CommandText>
      </Query>
      <Fields>
        <Field Name="Order_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Order_ID</DataField>
        </Field>
        <Field Name="Order_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Order_Date</DataField>
        </Field>
        <Field Name="Customer_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_ID</DataField>
        </Field>
        <Field Name="Customer_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_Name</DataField>
        </Field>
        <Field Name="Order_Status">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Order_Status</DataField>
        </Field>
        <Field Name="Order_Channel">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Order_Channel</DataField>
        </Field>
        <Field Name="Product_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_ID</DataField>
        </Field>
        <Field Name="Product_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_Name</DataField>
        </Field>
        <Field Name="Category_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Category_Name</DataField>
        </Field>
        <Field Name="Quantity">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Quantity</DataField>
        </Field>
        <Field Name="Unit_Price">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Unit_Price</DataField>
        </Field>
        <Field Name="Discount_Percentage">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Discount_Percentage</DataField>
        </Field>
        <Field Name="Line_Total">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Line_Total</DataField>
        </Field>
        <Field Name="Profit_Amount">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Profit_Amount</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Product_Category">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    c.Category_ID,
    c.Category_Name,
    p.Product_ID,
    p.Product_Name,
    SUM(oi.Quantity) AS Units_Sold,
    SUM(oi.Line_Total) AS Revenue,
    SUM(oi.Profit_Amount) AS Profit
FROM brainbees_ecommerce.dim_categories c
INNER JOIN brainbees_ecommerce.dim_products p
    ON c.Category_ID = p.Category_ID
INNER JOIN brainbees_ecommerce.fact_order_items oi
    ON p.Product_ID = oi.Product_ID
GROUP BY
    c.Category_ID,
    c.Category_Name,
    p.Product_ID,
    p.Product_Name
ORDER BY
    c.Category_Name,
    p.Product_Name;</CommandText>
      </Query>
      <Fields>
        <Field Name="Category_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Category_ID</DataField>
        </Field>
        <Field Name="Category_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Category_Name</DataField>
        </Field>
        <Field Name="Product_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_ID</DataField>
        </Field>
        <Field Name="Product_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_Name</DataField>
        </Field>
        <Field Name="Units_Sold">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Units_Sold</DataField>
        </Field>
        <Field Name="Revenue">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Revenue</DataField>
        </Field>
        <Field Name="Profit">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Profit</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Customer_Analysis">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    c.Customer_ID,
    c.Customer_Segment,
    c.Loyalty_Tier,
    CONCAT(c.First_Name, ' ', c.Last_Name) AS Customer_Name,
    COUNT(DISTINCT o.Order_ID) AS Total_Orders,
    COALESCE(SUM(oi.Line_Total), 0) AS Revenue,
    COALESCE(SUM(oi.Line_Total), 0) AS Customer_Lifetime_Value
FROM brainbees_ecommerce.dim_customers c
LEFT JOIN brainbees_ecommerce.fact_orders o
    ON c.Customer_ID = o.Customer_ID
LEFT JOIN brainbees_ecommerce.fact_order_items oi
    ON o.Order_ID = oi.Order_ID
GROUP BY
    c.Customer_ID,
    c.Customer_Segment,
    c.Loyalty_Tier,
    c.First_Name,
    c.Last_Name
ORDER BY
    c.Customer_Segment,
    c.Loyalty_Tier,
    Customer_Name;</CommandText>
      </Query>
      <Fields>
        <Field Name="Customer_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_ID</DataField>
        </Field>
        <Field Name="Customer_Segment">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_Segment</DataField>
        </Field>
        <Field Name="Loyalty_Tier">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Loyalty_Tier</DataField>
        </Field>
        <Field Name="Customer_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_Name</DataField>
        </Field>
        <Field Name="Total_Orders">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>Total_Orders</DataField>
        </Field>
        <Field Name="Revenue">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Revenue</DataField>
        </Field>
        <Field Name="Customer_Lifetime_Value">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Customer_Lifetime_Value</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Payment_Operations">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    Payment_Method,
    Payment_Status,
    COUNT(Payment_ID) AS Payment_Count,
    SUM(Amount) AS Payment_Amount,
    SUM(
        CASE
            WHEN Payment_Status = 'Refunded'
            THEN Amount
            ELSE 0
        END
    ) AS Refund_Amount
FROM brainbees_ecommerce.fact_payments
GROUP BY
    Payment_Method,
    Payment_Status
ORDER BY
    Payment_Method,
    Payment_Status</CommandText>
      </Query>
      <Fields>
        <Field Name="Payment_Method">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payment_Method</DataField>
        </Field>
        <Field Name="Payment_Status">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Payment_Status</DataField>
        </Field>
        <Field Name="Payment_Count">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>Payment_Count</DataField>
        </Field>
        <Field Name="Payment_Amount">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Payment_Amount</DataField>
        </Field>
        <Field Name="Refund_Amount">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Refund_Amount</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Reviews">
      <Query>
        <DataSourceName>Brainbees_MySQL</DataSourceName>
        <CommandText>SELECT
    Review_ID,
    Product_ID,
    Product_Name,
    Category_ID,
    Category_Name,
    Customer_ID,
    CONCAT(First_Name, ' ', Last_Name) AS Customer_Name,
    Rating,
    Review_Text,
    Review_Date
FROM brainbees_ecommerce.vw_product_reviews
ORDER BY
    Review_Date DESC,
    Review_ID;</CommandText>
      </Query>
      <Fields>
        <Field Name="Review_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Review_ID</DataField>
        </Field>
        <Field Name="Product_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_ID</DataField>
        </Field>
        <Field Name="Product_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product_Name</DataField>
        </Field>
        <Field Name="Category_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Category_ID</DataField>
        </Field>
        <Field Name="Category_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Category_Name</DataField>
        </Field>
        <Field Name="Customer_ID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Customer_ID</DataField>
